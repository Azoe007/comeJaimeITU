# Ignorer les fichiers generes dans writable, mais garder les dossiers.
/writable/*
!/writable/index.html
!/writable/cache/
!/writable/cache/index.html
!/writable/logs/
!/writable/logs/index.html
!/writable/session/
!/writable/session/index.html
!/writable/debugbar/
!/writable/debugbar/index.html
!/writable/uploads/
!/writable/uploads/index.html

/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/uploads/*
!/writable/uploads/index.html

# Ignorer les fichiers de base de donnees s'ils sont dans writable.
/writable/**/*.db
/writable/**/*.sqlite
